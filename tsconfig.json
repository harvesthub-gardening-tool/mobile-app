{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "preserveSymlinks": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "../../app/components/*": [
        "./src/components/*"
      ],
      "../../app/constants/*": [
        "./src/constants/*"
      ],
      "../../app/context/*": [
        "./src/context/*"
      ],
      "../../app/hooks/*": [
        "./src/hooks/*"
      ],
      "../../app/services/*": [
        "./src/services/*"
      ],
      "../../app/theme/*": [
        "./src/theme/*"
      ],
      "../../app/types/*": [
        "./src/types/*"
      ],
      "../../app/utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "__tests__"
  ]
}
